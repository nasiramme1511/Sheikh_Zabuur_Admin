// ==============================================================================
// Sheikh Zabuur Admin Dashboard — Database Schema
// ==============================================================================
// Target Engine: PostgreSQL 14+ (Hosted on Neon / Local PostgreSQL)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Role-Based Access Control (RBAC)
// ------------------------------------------------------------------------------

model AdminRole {
  id              String           @id // Canonical key: "SUPER_ADMIN", "CONTENT_MANAGER", "EDITOR", "VIEWER"
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users           AdminUser[]
  rolePermissions RolePermission[]

  @@map("admin_roles")
}

model Permission {
  id              String           @id // Canonical key: e.g. "catalog:publish", "tracks:write"
  name            String           @unique
  description     String?
  module          String           // Grouping: "AUTH", "CATALOG", "MEDIA", "USERS", "SYSTEM"
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// Administrator User Accounts & Sessions
// ------------------------------------------------------------------------------

model AdminUser {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  name                String
  roleId              String
  isActive            Boolean          @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  role                AdminRole        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions            AdminSession[]
  auditLogs           AuditLog[]
  releases            CatalogRelease[]

  @@index([roleId])
  @@index([isActive])
  @@index([email])
  @@map("admin_users")
}

model AdminSession {
  id               String    @id @default(uuid())
  userId           String
  sessionTokenHash String    @unique // SHA-256 hash of the secure cookie session token
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// ------------------------------------------------------------------------------
// Audit Trail & Tamper-Evident System Logs
// ------------------------------------------------------------------------------

model AuditLog {
  id          String     @id @default(uuid())
  adminUserId String?
  action      String     // e.g. "AUTH_LOGIN", "TRACK_CREATE", "CATALOG_PUBLISH"
  entityType  String     // e.g. "AdminUser", "AudioTrack", "CatalogRelease"
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// System Settings & Feature Configuration
// ------------------------------------------------------------------------------

model SystemSetting {
  key         String   @id // Key identifier: e.g. "maintenance_mode", "min_mobile_version"
  value       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// ------------------------------------------------------------------------------
// Content Hierarchy: Modules, Categories, and Tracks
// ------------------------------------------------------------------------------

model AudioModule {
  id             String          @id // Canonical slug: "beyquna", "usul", "tafseer", etc.
  title          String
  amharicTitle   String?
  arabicTitle    String?
  description    String?
  iconName       String?
  order          Int             @default(0)
  submoduleCount Int             @default(0)
  totalTracks    Int             @default(0)
  isActive       Boolean         @default(true)
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  categories     AudioCategory[]
  tracks         AudioTrack[]

  @@map("audio_modules")
}

model AudioCategory {
  id           String          @id // Canonical slug: "usul-kitabul-tohid", "tajreed-juz-1", etc.
  moduleId     String
  parentId     String?         // Supports recursive subcategories (e.g. tajreed-juz-1)
  title        String
  amharicTitle String?
  arabicTitle  String?
  description  String?
  order        Int             @default(0)
  trackCount   Int             @default(0)
  isActive     Boolean         @default(true)
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  module       AudioModule     @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  parent       AudioCategory?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Restrict)
  children     AudioCategory[] @relation("Subcategories")
  tracks       AudioTrack[]

  @@index([moduleId])
  @@index([parentId])
  @@index([order])
  @@map("audio_categories")
}

model AudioTrack {
  id                String        @id // Canonical slug: "beyquna-001", "usul-kitabul-tohid-001", etc.
  moduleId          String
  categoryId        String
  parentId          String        // Direct container identifier
  trackNumber       Int
  trackOrder        Int?
  title             String
  amharicTitle      String?
  arabicTitle       String?
  originalFilename  String?
  relativePath      String?
  storageKey        String?
  remoteUrl         String
  duration          Int           @default(0) // Duration in seconds
  formattedDuration String?
  fileSize          BigInt        @default(0) // Physical file size in bytes
  formattedFileSize String?
  format            String        @default("mp3")
  downloadStatus    String        @default("none")
  isPlaceholder     Boolean       @default(false)
  isPublished       Boolean       @default(true)
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  module            AudioModule   @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  category          AudioCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([moduleId])
  @@index([categoryId])
  @@index([parentId])
  @@index([trackNumber])
  @@index([isPublished])
  @@map("audio_tracks")
}

// ------------------------------------------------------------------------------
// Catalog Releases & Publication Manifests
// ------------------------------------------------------------------------------

model CatalogRelease {
  id              String      @id @default(uuid())
  version         String      @unique // e.g. "2.0.0"
  checksumMd5     String
  totalModules    Int
  totalCategories Int
  totalTracks     Int
  totalSizeBytes  BigInt
  storageUrl      String?
  releaseNotes    String?
  status          String      @default("published") // "published", "rolled_back"
  publishedById   String?
  publishedAt     DateTime    @default(now())

  publishedBy     AdminUser?  @relation(fields: [publishedById], references: [id])

  @@map("catalog_releases")
}
