# ==============================================================================
# Sheikh Zabuur Admin Dashboard — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# Never commit the actual .env file or real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://admin.sheikhzabur.com

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# For serverless deployment (Vercel, AWS Lambda), use the pooled connection string:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Optional direct URL for running Prisma migrations:
# DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Authentication & Session Security
# ------------------------------------------------------------------------------
# 32+ character high-entropy cryptographically secure random secret
AUTH_SECRET="replace-with-a-secure-random-secret-at-least-32-characters-long"

# ------------------------------------------------------------------------------
# 4. S3-Compatible Cloud Object Storage (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# When left empty, the application runs in local development simulation mode.
STORAGE_PROVIDER="cloudflare-r2"
STORAGE_BUCKET_NAME="sheikh-zabuur-audio-catalog"
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="your-r2-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-r2-secret-access-key"
STORAGE_PUBLIC_BASE_URL="https://audio.sheikhzabur.com"

# ------------------------------------------------------------------------------
# 5. Mobile Audio Streaming CDN
# ------------------------------------------------------------------------------
# Base URL for streaming audio files in mobile client and admin preview player
NEXT_PUBLIC_CDN_BASE_URL="https://audio.sheikhzabur.com"

# ------------------------------------------------------------------------------
# 6. Push Notifications (Expo Push Gateway)
# ------------------------------------------------------------------------------
# Optional: Expo Access Token for authenticated push notifications
EXPO_ACCESS_TOKEN=""
